// Perito · 02 · Execução (T1059 Command and Scripting Interpreter, T1204 User Execution, T1218 System Binary Proxy Execution, T1105 Ingress Tool Transfer, T1071 C2)
// Placeholders: {{host}} {{inicio}} {{fim}} {{sha256}}

// [Q2.1] PowerShell ofuscado, oculto ou com download
// Interpretar: -enc / -w hidden / DownloadString / IEX são fortes indicadores. Decodifique o base64 (UTF-16LE) e registre o conteúdo nos achados.
DeviceProcessEvents
| where Timestamp between (datetime({{inicio}}) .. datetime({{fim}}))
| where FileName in~ ("powershell.exe","pwsh.exe")
| where ProcessCommandLine has_any ("-enc","-encodedcommand","frombase64string","downloadstring","downloadfile","iex","invoke-expression","hidden","bypass","invoke-webrequest","iwr ","net.webclient")
| extend B64 = extract(@"(?i)-e(?:nc|ncodedcommand)?\s+([A-Za-z0-9+/=]{20,})", 1, ProcessCommandLine)
| extend Decodificado = iff(isnotempty(B64), base64_decode_tostring(B64), "")
| project TableName = "DeviceProcessEvents", Timestamp, DeviceName, ActionType, AccountName, InitiatingProcessFileName, FileName, ProcessCommandLine, Decodificado, SHA256

// [Q2.2] LOLBins com uso típico de ataque
DeviceProcessEvents
| where Timestamp between (datetime({{inicio}}) .. datetime({{fim}}))
| where (FileName =~ "rundll32.exe" and ProcessCommandLine has_any ("javascript:","comsvcs",@"\users\",@"\appdata\",@"\programdata\"))
     or (FileName =~ "regsvr32.exe" and ProcessCommandLine has_any ("/i:http","scrobj.dll"))
     or (FileName =~ "mshta.exe")
     or (FileName =~ "certutil.exe" and ProcessCommandLine has_any ("-urlcache","-decode","-split"))
     or (FileName =~ "bitsadmin.exe" and ProcessCommandLine has "/transfer")
     or (FileName =~ "wmic.exe" and ProcessCommandLine has_any ("process call create","/node:"))
| project TableName = "DeviceProcessEvents", Timestamp, DeviceName, ActionType, AccountName, InitiatingProcessFileName, FileName, ProcessCommandLine, SHA256

// [Q2.3] Executáveis gravados em pastas graváveis pelo usuário e depois executados
let gravados = DeviceFileEvents
| where Timestamp between (datetime({{inicio}}) .. datetime({{fim}}))
| where ActionType == "FileCreated" and FileName matches regex @"(?i)\.(exe|dll|ps1|bat|vbs|js)$"
| where FolderPath has_any (@"\AppData\", @"\ProgramData\", @"\Users\Public\", @"\Temp\", @"\Downloads\")
| project ArqTs = Timestamp, DeviceName, SHA256, FolderPath, Criador = InitiatingProcessFileName;
gravados
| join kind=inner (DeviceProcessEvents | project ExecTs = Timestamp, DeviceName, SHA256, ProcessCommandLine, AccountName) on DeviceName, SHA256
| project ArqTs, ExecTs, DeviceName, AccountName, FolderPath, SHA256, Criador, ProcessCommandLine

// [Q2.4] Árvore a partir de um SHA256 suspeito (o que ele lançou e quem o lançou)
DeviceProcessEvents
| where Timestamp between (datetime({{inicio}}) .. datetime({{fim}}))
| where InitiatingProcessSHA256 == "{{sha256}}" or SHA256 == "{{sha256}}"
| project TableName = "DeviceProcessEvents", Timestamp, DeviceName, ActionType, AccountName, InitiatingProcessFileName, FileName, ProcessCommandLine, SHA256
| order by Timestamp asc

// [Q2.5] Prevalência do hash na organização (é raro? em quantos hosts?)
DeviceFileEvents
| where Timestamp > ago(30d)
| where SHA256 == "{{sha256}}"
| summarize Hosts = dcount(DeviceName), PrimeiraVez = min(Timestamp), UltimaVez = max(Timestamp), Nomes = make_set(FileName, 10), HostsLista = make_set(DeviceName, 50)

// [Q2.6] Conexões para a internet iniciadas por interpretadores ou LOLBins (C2, T1071)
DeviceNetworkEvents
| where Timestamp between (datetime({{inicio}}) .. datetime({{fim}}))
| where InitiatingProcessFileName in~ ("powershell.exe","pwsh.exe","rundll32.exe","regsvr32.exe","mshta.exe","wscript.exe","cscript.exe","certutil.exe","bitsadmin.exe")
| where RemoteIPType == "Public"
| project TableName = "DeviceNetworkEvents", Timestamp, DeviceName, ActionType, InitiatingProcessAccountName, InitiatingProcessFileName, InitiatingProcessCommandLine, RemoteIP, RemotePort, RemoteUrl, LocalIP

// [Q2.7] Quem mais falou com o IP/domínio de C2? (escopo)
DeviceNetworkEvents
| where Timestamp between (datetime({{inicio}}) - 7d .. datetime({{fim}}))
| where RemoteIP == "{{ip}}" or RemoteUrl has "<dominio>"
| summarize Conexoes = count(), Primeira = min(Timestamp), Ultima = max(Timestamp), Processos = make_set(InitiatingProcessFileName, 10) by DeviceName
