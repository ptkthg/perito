{
  "name": "perito-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:glyphs": "uv run --with fonttools --with brotli python -X utf8 scripts/check-glyphs.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/iosevka": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.28",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
